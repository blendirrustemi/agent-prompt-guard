# Existing local PostgreSQL, using your operating-system database role:
DATABASE_URL=postgresql://localhost:5432/pijd

# For the optional Docker Compose database, use this value instead:
# DATABASE_URL=postgresql://pijd:pijd@localhost:55432/pijd

# Kafka broker from backend/compose.yaml:
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094

# These host-side settings are for local Python/CLI commands. Full Compose startup
# supplies db:5432 and kafka:9092 explicitly; it does not modify this file.

# P9/P10 burst worker: block a source sending BURST_THRESHOLD prompts within
# BURST_WINDOW_SECONDS, for BURST_COOLDOWN_SECONDS.
BURST_WINDOW_SECONDS=60
BURST_THRESHOLD=10
BURST_COOLDOWN_SECONDS=300

# P3 advisory matching; these settings do not change Batch 2 probabilities or P7 thresholds.
P3_SIMILARITY_THRESHOLD=0.85
P3_RECENT_SECONDS=300
P3_RECENT_CAPACITY=1000
P3_RECENT_MIN_SCORE=0.90

# Ollama running on this computer, and the model the agent uses:
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

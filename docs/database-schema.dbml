// Database schema sketch for https://dbdiagram.io (paste this file into the editor).
// Source of truth: backend/schema.sql

Project agent_prompt_guard {
  database_type: 'PostgreSQL'
  Note: 'Prompts submitted through the web UI and the guard classifier verdict for each one.'
}

Table prompts {
  id uuid [pk, note: 'Generated by the app (uuid4)']
  text text [not null, note: 'Non-blank, at most 8000 characters']
  source text [not null, default: 'web']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    created_at [name: 'prompts_created_at_idx', note: 'DESC; used to list the newest prompts']
  }
}

Table guard_results {
  prompt_id uuid [pk, ref: - prompts.id, note: 'ON DELETE CASCADE; created as pending with each prompt']
  decision text [not null, default: 'pending', note: "One of 'pending', 'allow', 'block', 'review'"]
  malicious_score "double precision" [note: 'Between 0 and 1']
  attack_type text
  reason text
  model_version text
  checked_at timestamptz [note: 'Set when the classifier saves its result']
}

// Database schema sketch for https://dbdiagram.io (paste this file into the editor).
// Source of truth: backend/schema.sql

Project agent_prompt_guard {
  database_type: 'PostgreSQL'
  Note: 'Prompts submitted through the web UI, the guard classifier verdict for each one, rate-limiter decisions, the agent runs, and the imported datasets.'
}

Table prompts {
  id uuid [pk, note: 'Generated by the app (uuid4)']
  text text [not null, note: 'Non-blank, at most 8000 characters']
  source text [not null, default: 'web']
  created_at timestamptz [not null, default: `now()`]
  dataset_prompt_id uuid [ref: > dataset_prompts.id, note: 'ON DELETE SET NULL; NULL for web prompts, set for replayed dataset rows']

  indexes {
    created_at [name: 'prompts_created_at_idx', note: 'DESC; used to list the newest prompts']
    dataset_prompt_id [name: 'prompts_dataset_prompt_id_idx']
  }
}

Table guard_results {
  prompt_id uuid [pk, ref: - prompts.id, note: 'ON DELETE CASCADE; created as pending with each prompt']
  decision text [not null, default: 'pending', note: "One of 'pending', 'allow', 'block', 'review'"]
  malicious_score "double precision" [note: 'Between 0 and 1']
  attack_type text
  reason text
  model_version text
  checked_at timestamptz [note: 'Set when the classifier saves its result']
}

// One row per prompt the agent worker handled.
Table agent_runs {
  prompt_id uuid [pk, ref: - prompts.id, note: 'ON DELETE CASCADE; at most one run per prompt']
  status text [not null, note: "One of 'completed', 'failed', 'rejected' (stored decision was not 'allow')"]
  response text [note: "The agent's answer"]
  tool_calls jsonb [not null, default: `'[]'::jsonb`, note: 'List of {name, args}']
  latency_ms integer
  model text [note: 'Ollama model used']
  error text [note: 'Why the run failed or was rejected']
  created_at timestamptz [not null, default: `now()`]
}

// P10 rate-limiter output: one row per prompt seen by the burst worker; also published to throttle_decisions for P7.
Table throttle_decisions {
  prompt_id uuid [pk, ref: - prompts.id, note: 'ON DELETE CASCADE']
  source text [not null, note: 'Source/IP the window is counted for']
  action text [not null, note: "One of 'allow', 'block'"]
  reason text [note: "'burst_detected' (started the block), 'source_blocked' (during cooldown), NULL for allow"]
  window_count integer [not null, note: 'Prompts from this source in the window, including this one']
  window_seconds integer [not null, note: 'Window length used for this decision']
  threshold integer [not null, note: 'Burst threshold used for this decision']
  blocked_until timestamptz [note: 'End of the block; NULL for allow']
  burst_started boolean [not null, default: false, note: 'TRUE on the prompt that started a block (burst alert)']
  event_time timestamptz [not null, note: "The raw event's created_at"]
  decided_at timestamptz [not null, default: `now()`]

  indexes {
    (source, event_time) [name: 'throttle_decisions_source_time_idx', note: 'event_time DESC']
    event_time [name: 'throttle_decisions_bursts_idx', note: 'DESC, partial: WHERE burst_started']
  }
}

// Imported training and evaluation data; replayed rows are linked from prompts.dataset_prompt_id.
Table dataset_prompts {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Importers pass a stable uuid5 so re-imports skip existing rows']
  text text [not null, note: 'Non-blank; no length limit']
  label smallint [not null, note: '1 = malicious, 0 = benign']
  source_dataset text [not null, note: "One of 'neuralchemy', 'deepset', 'jackhhao'"]
  source text [note: 'Upstream source inside the dataset, e.g. neuralchemy_v1']
  split text [not null, note: 'e.g. train, validation, test']
  category text [note: "Dataset's own category, e.g. control, chain_of_thought"]
  attack_group text [note: 'Attack type or family (B3)']
  group_id text [note: 'Template group; one group stays in one split']
  include_in_baseline boolean [not null, default: false, note: 'Rows used to train the B1/B2 baselines']
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'Other original fields']

  indexes {
    (source_dataset, split) [name: 'dataset_prompts_source_split_idx']
  }
}
